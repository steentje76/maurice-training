# RC0 — voorbeeld. Kopieer dit bestand naar android/keystore.properties en vul het in.
# keystore.properties staat in .gitignore en mag NOOIT worden gecommit.
#
# Een upload-sleutel maak je eenmalig aan met (JDK 17+):
#
#   keytool -genkeypair -v \
#     -keystore ~/trainingskompas-upload.jks \
#     -alias trainingskompas \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Bewaar het .jks-bestand en de wachtwoorden buiten de repository en maak er een
# back-up van: raak je de upload-sleutel kwijt, dan is een reset via Google Play
# nodig voordat je opnieuw kunt uploaden.
#
# In plaats van dit bestand kun je ook de omgevingsvariabelen TK_KEYSTORE_FILE,
# TK_KEYSTORE_PASSWORD, TK_KEY_ALIAS en TK_KEY_PASSWORD zetten (CI).

storeFile=/absoluut/pad/naar/trainingskompas-upload.jks
storePassword=
keyAlias=trainingskompas
keyPassword=
