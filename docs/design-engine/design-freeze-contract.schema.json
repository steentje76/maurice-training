      "design-freeze JSON",
      "implementation-contract JSON",
      "Claude implementation prompt"
    ],
    "acceptance": [
      "capability preservation",
      "route invariants",
      "state coverage",
      "evidence/data guards",
      "component reuse",
      "accessibility",
      "responsive viewports",
      "visual/runtime comparison",
      "source freshness"
