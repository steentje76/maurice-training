      "validation.freeze_ready == true",
      "zero unresolved HARD conflicts",
      "source snapshot current",
      "PO selection recorded",
      "approval timestamp recorded"
    ],
    "immutable_fields": [
      "flow_id",
      "scenario_id",
      "baseline_main_sha",
      "source_snapshot",
      "rule_ids",
      "route_invariants",
      "capability_coverage",
