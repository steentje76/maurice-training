  "policies": [
    {
      "cmd": "DELETE",
      "qual": "(((scope = 'personal'::text) AND (created_by = auth.uid())) OR ((scope = 'gym'::text) AND (gym_id = ( SELECT users.gym_id\n   FROM users\n  WHERE (users.id = (auth.uid())::text))) AND (( SELECT users.gym_role_level\n   FROM users\n  WHERE (users.id = (auth.uid())::text)) >= 1)) OR ((scope = 'global'::text) AND (( SELECT users.system_role\n   FROM users\n  WHERE (users.id = (auth.uid())::text)) = ANY (ARRAY['developer'::text, 'support'::text]))))",
      "roles": [
        "public"
      ],
      "tablename": "exercises",
      "permissive": "PERMISSIVE",
      "policyname": "exercises_delete_v333",
      "schemaname": "public",
      "with_check": null
    },
    {
