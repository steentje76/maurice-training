      "definition": "CREATE OR REPLACE FUNCTION public.set_user_id_from_auth()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\n    BEGIN\r\n      IF auth.uid() IS NOT NULL THEN\r\n        NEW.user_id := auth.uid();\r\n      END IF;\r\n      RETURN NEW;\r\n    END;\r\n    $function$\n",
