      "with_check": "((scope = 'personal'::text) OR ((scope = 'gym'::text) AND (( SELECT users.gym_role_level\n   FROM users\n  WHERE (users.id = (auth.uid())::text)) >= 1)) OR ((scope = 'global'::text) AND (( SELECT users.system_role\n   FROM users\n  WHERE (users.id = (auth.uid())::text)) = ANY (ARRAY['developer'::text, 'support'::text]))))"
    },
    {
      "cmd": "SELECT",
      "qual": "((scope = 'global'::text) OR ((scope = 'gym'::text) AND (gym_id = ( SELECT users.gym_id\n   FROM users\n  WHERE (users.id = (auth.uid())::text)))) OR ((scope = 'personal'::text) AND (created_by = auth.uid())) OR ((scope = 'personal'::text) AND (EXISTS ( SELECT 1\n   FROM content_shares cs\n  WHERE ((cs.content_type = 'exercise'::text) AND (cs.content_id = exercises.id) AND (cs.shared_with = auth.uid()))))))",
