{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TK UX Scenario Comparison",
  "type": "object",
  "required": [
    "id",
    "requirement",
    "status",
    "scenarios",
    "decision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TK-SCN-[A-Z]+-[0-9]{3}$"
    },
    "requirement": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY_FOR_PO",
        "DECIDED",
        "SUPERSEDED"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "steps",
          "metrics",
          "risks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mockup_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "from",
                "action",
                "to",
                "system_behaviour"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "system_behaviour": {
                  "type": "string"
                },
                "back_behaviour": {
                  "type": "string"
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "required": [
              "primary_task_taps",
              "decision_points",
              "screen_transitions",
              "interruptions",
              "new_patterns"
            ]
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "selected_scenario",
        "reason",
        "po_approved"
      ]
    }
  }
}
