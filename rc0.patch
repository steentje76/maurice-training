-// ══════════════════════════════════════════════════════════
-// SPIERHERSTEL — herstel% per spiergroep o.b.v. tijd + RPE
-// ══════════════════════════════════════════════════════════
-const MUSCLE_RECOVERY_HOURS = {
-  Quadriceps:72, Hamstrings:72, Billen:72, Rug:72, Benen:72,
-  Borst:60, Schouders:60,
-  Biceps:48, Triceps:48, Core:48, Grip:48, Traps:48, 'Achterste schouder':48, Armen:48
-};
-
-function rpeMultiplier(rpe){ return CalcCore.rpeMultiplier(rpe); } /* F1.5B: canonical shared core (recovery.v1) */
-
-function computeMuscleRecoveryPct(hoursSince, baseHours, rpe){ return CalcCore.calculateMuscleRecoveryPct(hoursSince, baseHours, rpe); } /* F1.5B: canonical shared core (recovery.v1) */
-
-// Zelfde herstel-berekening als refreshMuscleRecovery, maar geschaald naar alleen de
-// spieren die vandaag's programmatraining raakt — voor de coach-check-in (v311).
-async function getRelevantMuscleRecovery(muscleNames){
-  if(!muscleNames||!muscleNames.length)return [];
-  const twoWeeksAgo=new Date();twoWeeksAgo.setDate(twoWeeksAgo.getDate()-14);
-  const dateStr=twoWeeksAgo.toISOString().split('T')[0];
-  const ss=await sbGet('sessions','&date=gte.'+dateStr+'&order=date.desc,created_at.desc');
-  const lastHit={};
-  ss.forEach(s=>{
-    getExerciseMuscles(s.exercise_id).forEach(m=>{if(!lastHit[m])lastHit[m]={date:s.date,rpe:s.rpe};});
-  });
-  const now=new Date();
-  return muscleNames.filter(m=>MUSCLE_RECOVERY_HOURS[m]).map(m=>{
-    const hit=lastHit[m];
-    if(!hit)return {muscle:m,pct:100,hours:null};
-    const hoursSince=(now-new Date(hit.date))/3600000;
-    return {muscle:m,pct:computeMuscleRecoveryPct(hoursSince,MUSCLE_RECOVERY_HOURS[m],hit.rpe),hours:Math.round(hoursSince)};
-  });
-}
-// Pure beslislogica — los testbaar. Bepaalt OF en welke aanpassing wordt voorgesteld
-// (nooit stilzwijgend toegepast — de checkin-flow legt dit altijd eerst voor).
-function computeProgAdjustment(factor,muscleRecoveryRows,voelt,painMuscle){ return DecisionCore.computeProgAdjustment(factor,muscleRecoveryRows,voelt,painMuscle); } /* F1.7: canonical Decision Core (progression_adjust.v1) */
