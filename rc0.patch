-// Masters leeftijdscorrectie (IPF Masters factor)
-function mastersFactor(leeftijd){
-  if(leeftijd < 40) return 1.0;
-  if(leeftijd < 45) return 1.01;
-  if(leeftijd < 50) return 1.02;
-  if(leeftijd < 55) return 1.04;
-  if(leeftijd < 60) return 1.06;
-  if(leeftijd < 65) return 1.09;
-  return 1.12;
-}
-
-// Bodyweight-relatieve literatuurnormen per lift — bron voor fase1-standaardratio's
-const LIFT_NORMS = {
-  backsquat: 1.5, bench: 1.0, frontsquat: 1.2, shoulderpress: 0.65,
-  hexabar: 1.75, hpc: 0.75, hps: 0.55,
-  // F0.7D-STAP12: canonical TK-alias voor de gemigreerde anker-lift backsquat (identieke normwaarde).
-  'TK-000038': 1.5
-};
-// Verwachte 1RM op basis van niveau en leeftijd
-// v5.6.1: geen schatting meer zonder leeftijd/gewicht (voorheen viel dit stil terug op de
-// ontwikkelaars-default leeftijd 50 via de aanroeper) — RB2/RB3, geen berekening zonder profiel.
-function expected1RM(lift, gewicht, leeftijd, niveau){
-  if(!leeftijd || !gewicht) return null;
-  const niveauFactor = {beginner:0.5, gevorderd:0.75, ervaren:1.0, expert:1.2}[niveau] || 1.0;
-  const mf = mastersFactor(leeftijd);
-  const norm = LIFT_NORMS[lift] || 1.0;
-  return Math.round(gewicht * norm * niveauFactor * mf);
-}
-
-// ══════════════════════════════════════════════════════════
-// RATIOFACTOR-MOTOR (v299)
-// Fase1: standaardratio uit LIFT_NORMS (bodyweight-relatieve literatuurnormen)
-// Fase2: geleerd uit eigen data zodra n≥RATIO_MIN_OBS per lift (decay-gewogen 1RM)
-// Zelfde tweetraps-principe als revisiefactor.py (MMP-project): vaste standaardwaarde
-// tot er genoeg eigen observaties zijn, dan overschakelen, met bron-transparantie.
-// ══════════════════════════════════════════════════════════
-const RATIO_MIN_OBS = 5;    // drempel: vanaf hier telt fase2 (eigen data) mee per lift
-const RATIO_DECAY = 0.95;   // decay per week oud, zelfde principe als revisiefactor.py
-
-// Decay-gewogen 1RM-schatting uit een lijst sessies van 1 lift ({date,weight,reps})
-function weightedEst1RM(sessions, refDate){ return CalcCore.weightedOneRM(sessions, refDate?new Date(refDate):new Date(), RATIO_DECAY); } /* F1.6/DataAccess: canonical core (e1rm_weighted.v1) */
-
-function ratioConfidence(nA,nB){
-  const n = Math.min(nA,nB);
-  if(n < RATIO_MIN_OBS) return 'Laag';
-  if(n < RATIO_MIN_OBS*2) return 'Middel';
-  return 'Hoog';
-}
-
-// Kernfunctie: ratio tussen twee liften. estA/estB = output van weightedEst1RM.
-// Retourneert null-ratio als geen van beide bronnen beschikbaar is.
-function ratioFactor(liftA, liftB, estA, estB){
-  const normA = LIFT_NORMS[liftA], normB = LIFT_NORMS[liftB];
-  const fase1Ratio = (normA!=null && normB!=null) ? normA/normB : null;
-  const genoegData = estA && estB && estA.n>=RATIO_MIN_OBS && estB.n>=RATIO_MIN_OBS && estA.est && estB.est;
-  if(genoegData){
-    return {ratio: estA.est/estB.est, bron:'eigen data', nA:estA.n, nB:estB.n, betrouwbaarheid: ratioConfidence(estA.n,estB.n)};
-  }
-  return {ratio: fase1Ratio, bron:'algemene richtlijn', nA:estA?estA.n:0, nB:estB?estB.n:0, betrouwbaarheid:'Laag'};
-}
-
-// ══════════════════════════════════════════════════════════
-// F43 — STARTING STRENGTH (deterministisch, geen AI-berekening)
-// ══════════════════════════════════════════════════════════
-// Doel: uit 1–3 opgegeven referentielifts deterministisch een geschat 1RM afleiden voor
-// de canonieke hoofdliften, zodat de EERSTE training slimme startgewichten heeft i.p.v.
-// een leeg vertrekpunt. Dit is exact het idee dat de sporter opperde ("ik kan 100 kg
-// squatten → leid daaruit af…", "handig om gewichten voor de eerste keer in te schatten").
-//
-// ARCHITECTUUR / BOUNDARY:
-//  • 1RM per opgegeven lift → CalcCore (epley1RMRaw). GEEN eigen formule.
-//  • Cross-lift-afleiding → LIFT_NORMS-ratio (dezelfde 'algemene richtlijn' als ratioFactor).
-//  • AI rekent NIETS: de coach formuleert hooguit de vraag en de uitleg-zin.
-//  • Persistentie (optioneel, GEEN schemawijziging): de opgegeven 1RM's kunnen via de
-//    BESTAANDE setter upsertExerciseGoalField(exId,'one_rm',v) in exercise_goals worden
-//    opgeslagen — een door de sporter zélf verklaard 1RM is echte data (geen verzonnen
-//    sessie), en getOneRM()/resolveWorkingWeight pikken het daarna vanzelf op. Afgeleide
-//    (ratio-)schattingen worden NIET stil weggeschreven — alleen getoond als richtlijn.
-//
-// Input : refs = [{lift, weight, reps}]   (lift = canoniek id uit LIFT_NORMS, bv 'bench')
-// Output: { provided:{lift:{est1RM,weight,reps,source:'opgegeven',confidence:'Hoog'}},
-//           derived :{lift:{est1RM,fromLift,ratio,source:'richtlijn',confidence:'Laag'}} }
-// Zuiver: leest alleen LIFT_NORMS + CalcCore; geen DOM/DB/side-effects.
-function estimateStartingStrength(refs){
-  const provided={}, derived={};
-  (refs||[]).forEach(r=>{
-    if(!r||r.lift==null||LIFT_NORMS[r.lift]==null)return;
-    const w=parseFloat(r.weight), reps=parseInt(r.reps,10);
-    if(!(w>0)||!(reps>0)||reps>30)return;            // onrealistische reps → overslaan (geen gok)
-    let e1rm=null;
-    try{ e1rm=Math.round(epley1RMRaw(w,reps)); }catch(_){ e1rm=null; }
-    if(!(e1rm>0))return;
-    provided[r.lift]={est1RM:e1rm, weight:w, reps:reps, source:'opgegeven', confidence:'Hoog'};
-  });
-  const anchors=Object.keys(provided);
-  if(anchors.length){
-    Object.keys(LIFT_NORMS).forEach(lift=>{
-      if(provided[lift])return;                       // eigen opgave heeft altijd voorrang
-      let best=null;
-      anchors.forEach(a=>{
-        const ratio=LIFT_NORMS[lift]/LIFT_NORMS[a];
-        const est=Math.round(provided[a].est1RM*ratio);
-        // kies het meest 'compound' anker (hoogste norm) voor de stabielste afleiding
-        if(est>0 && (best===null || LIFT_NORMS[a]>LIFT_NORMS[best.fromLift])){
-          best={est1RM:est, fromLift:a, ratio:Math.round(ratio*100)/100, source:'richtlijn', confidence:'Laag'};
-        }
-      });
-      if(best)derived[lift]=best;
-    });
-  }
-  return {provided, derived};
-}
