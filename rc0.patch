+h1{font-size:28px;line-height:1.25;margin:0 0 6px}
+h2{font-size:19px;margin:34px 0 8px;padding-top:20px;border-top:1px solid var(--lijn)}
+h2:first-of-type{border-top:0;padding-top:0}
+h3{font-size:15px;margin:18px 0 4px}
+p,li{color:var(--tekst)}
+.meta{color:var(--zacht);font-size:14px;margin:0 0 24px}
+.let-op{background:#fff;border:1px solid var(--lijn);border-left:3px solid var(--accent);
+        border-radius:8px;padding:14px 16px;margin:22px 0;font-size:14px;color:var(--zacht)}
+table{border-collapse:collapse;width:100%;margin:10px 0 4px;font-size:14px}
