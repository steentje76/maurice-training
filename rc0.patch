-const MUSCLE_NAME_TO_SVG_IDS = {
-  Quadriceps: ['left_quadriceps','right_quadriceps'],
-  Hamstrings: ['left_hamstring','right_hamstring'],
-  Billen: ['left_glute','right_glute'],
-  Rug: ['left_upper_back','right_upper_back','left_lower_back','right_lower_back'],
-  Benen: ['left_quadriceps','right_quadriceps','left_hamstring','right_hamstring','left_calf','right_calf'],
-  Borst: ['left_pectoralis','right_pectoralis'],
-  Schouders: ['left_deltoid','right_deltoid'],
-  Biceps: ['left_biceps','right_biceps'],
-  Triceps: ['left_triceps','right_triceps'],
-  Core: ['rectus_abdominis','left_external_oblique','right_external_oblique'],
-  Grip: ['left_forearm','right_forearm'],
-  Traps: ['left_trapezius','right_trapezius'],
-  'Achterste schouder': ['left_deltoid','right_deltoid'],
-  Armen: ['left_biceps','right_biceps','left_triceps','right_triceps','left_forearm','right_forearm'],
-};
-
-function muscleNamesToSvgIds(names){
-  const ids = new Set();
-  names.forEach(name=>{
-    (MUSCLE_NAME_TO_SVG_IDS[name]||[]).forEach(id=>ids.add(id));
-  });
-  return [...ids];
-}
-
-let muscleHeatmapView = 'front'; // 'front' | 'back', onthouden tussen refreshes
-
-function getMuscleSvgFor(view){
-  const isVrouw = (atleet && atleet.geslacht === 'vrouw');
-  if(view === 'back') return isVrouw ? FEMALE_BACK_SVG : MALE_BACK_SVG;
-  return isVrouw ? FEMALE_FRONT_SVG : MALE_FRONT_SVG;
-}
-
-function renderMuscleHeatmap(containerId, setsBySvgId){
-  const el = document.getElementById(containerId);
-  if(!el) return;
-  const svgText = getMuscleSvgFor(muscleHeatmapView);
-  // altijd herladen bij view- of geslachtswissel (key bijhouden om onnodige re-renders te vermijden)
-  const key = muscleHeatmapView + '_' + (atleet && atleet.geslacht);
-  if(el.dataset.svgKey !== key){
-    el.innerHTML = svgText;
-    el.dataset.svgKey = key;
-  }
-  const svg = el.querySelector('svg');
-  if(!svg) return;
-  svg.querySelectorAll('#muscles > g').forEach(g=>{
-    const path = g.querySelector('path');
-    if(path){ path.style.fill = '#D9D9D9'; path.style.opacity = '1'; }
-  });
-  Object.entries(setsBySvgId).forEach(([svgId, sets])=>{
-    const g = svg.querySelector('#'+CSS.escape(svgId));
-    if(!g) return;
-    const path = g.querySelector('path');
-    if(!path) return;
-    // zelfde kleurlogica/drempels als de Spierherstel-kaart hierboven (var(--green)/var(--y)/var(--red))
-    const color = sets>=12 ? 'var(--green)' : sets>=6 ? 'var(--y)' : 'var(--red)';
-    path.style.fill = color;
-    path.style.opacity = '1';
-  });
-}
-
-// Labelconventie: de knop toont altijd de HUIDIGE weergave (moet overeenkomen met de afbeelding),
-// niet de bestemming. Gedeeld door beide toggles via updateViewToggleLabel().
-function updateViewToggleLabel(btnId, view){
-  const btn = document.getElementById(btnId);
-  if(btn) btn.textContent = view === 'front' ? 'Voorkant' : 'Achterkant';
-}
-function toggleMuscleHeatmapView(){
-  muscleHeatmapView = muscleHeatmapView === 'front' ? 'back' : 'front';
-  updateViewToggleLabel('muscle-heatmap-toggle-btn', muscleHeatmapView);
-  refreshMuscleHeatmap();
-}
