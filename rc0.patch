-// v5.6.3 (Sprint 5.6.3 — RB1): bewust NIET meegenomen in de tk_*-namespace-migratie.
-// Een IndexedDB-databasenaam hernoemen vereist het kopiëren van alle records naar een
-// nieuwe database (i.t.t. een synchrone localStorage-key-copy) — bij een offline-
-// sync-queue (nog niet-gesynchroniseerde trainingssessies) weegt dat risico niet op
-// tegen de cosmetische winst. Losse, apart geteste migratie-sprint indien gewenst.
-const OFFLINE_DB_NAME='maurice_offline', OFFLINE_STORE='queue';
-function offlineDb(){
-  return new Promise((resolve,reject)=>{
-    const req=indexedDB.open(OFFLINE_DB_NAME,1);
-    req.onupgradeneeded=()=>{req.result.createObjectStore(OFFLINE_STORE,{keyPath:'id',autoIncrement:true});};
-    req.onsuccess=()=>resolve(req.result);
-    req.onerror=()=>reject(req.error);
-  });
-}
-async function offlineQueueAdd(item){
-  try{
-    const db=await offlineDb();
-    return await new Promise((resolve,reject)=>{
-      const tx=db.transaction(OFFLINE_STORE,'readwrite');
-      tx.objectStore(OFFLINE_STORE).add({...item,ts:Date.now()});
-      tx.oncomplete=()=>resolve(true);
-      tx.onerror=()=>reject(tx.error);
-    });
-  }catch(e){console.error('offlineQueueAdd',e);return false;}
-}
-async function offlineQueueAll(){
-  try{
-    const db=await offlineDb();
-    return await new Promise((resolve,reject)=>{
-      const tx=db.transaction(OFFLINE_STORE,'readonly');
-      const req=tx.objectStore(OFFLINE_STORE).getAll();
-      req.onsuccess=()=>resolve(req.result);
-      req.onerror=()=>reject(req.error);
-    });
-  }catch(e){console.error('offlineQueueAll',e);return [];}
-}
-async function offlineQueueRemove(id){
-  try{
-    const db=await offlineDb();
-    return await new Promise((resolve,reject)=>{
-      const tx=db.transaction(OFFLINE_STORE,'readwrite');
-      tx.objectStore(OFFLINE_STORE).delete(id);
-      tx.oncomplete=()=>resolve(true);
-      tx.onerror=()=>reject(tx.error);
-    });
-  }catch(e){console.error('offlineQueueRemove',e);return false;}
-}
-// sbPostQ/sbPatchQ: als sbPost/sbPatch, maar queuen in IndexedDB bij netwerkfout i.p.v.
-// data verliezen. Geven bij een queue nog steeds true terug — de lokale flow (toast,
-// modal sluiten) mag gewoon doorgaan, de gebruiker hoeft niet te wachten op sync.
-async function sbPostQ(t,d){
-  if(!navigator.onLine){await offlineQueueAdd({table:t,method:'POST',body:d});updateOfflineBadge();return true;}
-  try{
-    const r=await fetch(`${SB_URL}/rest/v1/${t}`,{method:'POST',headers:{...SB_H,'Prefer':'return=representation'},body:JSON.stringify(d)});
-    if(!r.ok){const err=await r.text();console.error('sbPostQ',t,r.status,err);return false;}
-    return true;
-  }catch(e){
-    console.warn('sbPostQ offline, queued',t,e);
-    await offlineQueueAdd({table:t,method:'POST',body:d});
-    updateOfflineBadge();
-    return true;
-  }
-}
-async function sbPatchQ(t,f,d){
-  if(!navigator.onLine){await offlineQueueAdd({table:t,method:'PATCH',filter:f,body:d});updateOfflineBadge();return true;}
-  try{
-    const r=await fetch(`${SB_URL}/rest/v1/${t}?${f}`,{method:'PATCH',headers:{...SB_H,'Prefer':'return=representation'},body:JSON.stringify(d)});
-    if(!r.ok){console.error('sbPatchQ',t,r.status,await r.text());return false;}
-    return true;
-  }catch(e){
-    console.warn('sbPatchQ offline, queued',t,e);
-    await offlineQueueAdd({table:t,method:'PATCH',filter:f,body:d});
-    updateOfflineBadge();
-    return true;
-  }
-}
-// sbDelQ: als sbDel, maar queuet bij netwerkfout. Wordt alleen aangeroepen met een échte
-// (al gesynchroniseerde) Supabase-id — voor een item dat zelf nog in de queue staat
-// (pending POST, dus nog geen echte id) verwijdert de aanroeper direct uit de queue i.p.v.
-// hier een DELETE te queuen, zie deleteSessionEntry/deleteSessionDirect.
-async function sbDelQ(t,f){
-  if(!navigator.onLine){await offlineQueueAdd({table:t,method:'DELETE',filter:f});updateOfflineBadge();return true;}
-  try{
-    const r=await fetch(`${SB_URL}/rest/v1/${t}?${f}`,{method:'DELETE',headers:SB_H});
-    if(!r.ok){console.error('sbDelQ',t,r.status,await r.text());return false;}
-    return true;
-  }catch(e){
-    console.warn('sbDelQ offline, queued',t,e);
-    await offlineQueueAdd({table:t,method:'DELETE',filter:f});
-    updateOfflineBadge();
-    return true;
-  }
-}
-// Speelt de queue in volgorde af; stopt bij de eerste fout zodat de volgorde behouden
-// blijft.
-async function flushOfflineQueue(){
-  if(!navigator.onLine)return;
-  const items=await offlineQueueAll();
-  if(!items.length)return;
-  items.sort((a,b)=>a.id-b.id);
-  let syncedAny=false, skippedAny=false;
-  for(const item of items){
-    try{
-      const url=item.method==='POST'?`${SB_URL}/rest/v1/${item.table}`:`${SB_URL}/rest/v1/${item.table}?${item.filter}`;
-      const opts=item.method==='DELETE'
-        ?{method:'DELETE',headers:SB_H}
-        :{method:item.method,headers:{...SB_H,'Prefer':'return=representation'},body:JSON.stringify(item.body)};
-      const r=await fetch(url,opts);
-      if(!r.ok){
-        // v5.9.5: serverfout op dit ene item (bv. validatie, verwijzing naar inmiddels
-        // verwijderde data) mag niet alle latere, op zichzelf staande items blokkeren —
-        // die blijven anders voor altijd achter dit item hangen, ook bij de volgende
-        // sync-poging. Item blijft in de wachtrij staan (zichtbaar/beheerbaar via het
-        // bestaande wachtrij-scherm), maar de rest wordt gewoon geprobeerd.
-        console.error('flushOfflineQueue: item mislukt, wordt overgeslagen (blijft in wachtrij)',item.table,r.status,await r.text());
-        skippedAny=true;
-        continue;
-      }
-      await offlineQueueRemove(item.id);
-      syncedAny=true;
-    }catch(e){console.warn('flushOfflineQueue offline again, stop',e);break;}
-  }
-  updateOfflineBadge();
-  if(document.getElementById('m-offline-queue')?.classList.contains('open'))renderOfflineQueueModal();
-  if(syncedAny&&!(await offlineQueueAll()).length)toast('Offline sessies gesynchroniseerd');
-  else if(skippedAny)toast('Sommige offline items konden niet synchroniseren — bekijk de wachtrij voor details');
-}
-function updateOfflineBadge(){
-  offlineQueueAll().then(items=>{
-    const el=document.getElementById('offline-badge');
-    if(!el)return;
-    if(items.length){el.textContent=items.length+' wachtend op sync — tik voor details';el.style.display='block';}
-    else{el.style.display='none';}
-  });
-}
-// Korte, leesbare omschrijving van een queue-item voor het beheerscherm.
-function describeOfflineQueueItem(item){
-  const methodLbl={POST:'Nieuw',PATCH:'Wijziging',DELETE:'Verwijdering'}[item.method]||item.method;
-  if(item.table==='sessions'&&item.body){
-    const n=exercises?.find(e=>e.id===item.body.exercise_id)?.name||item.body.exercise_id||'sessie';
-    return `${methodLbl}: ${n} — ${item.body.date||''}`;
-  }
-  if(item.table==='exercises'&&item.body)return `${methodLbl} oefening: ${item.body.name||item.body.id}`;
-  if(item.table==='exercises'&&item.filter)return `PR-update oefening`;
-  if(item.table==='program_blocks')return `Programma-blok afgerond`;
-  if(item.table==='training_instances')return `${methodLbl}: trainingssessie (${item.body?.status||'update'})`;
-  return `${methodLbl}: ${item.table}`;
-}
