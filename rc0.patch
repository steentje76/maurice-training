-      r = await fetch('/.netlify/functions/'+fnPath, { method:'POST', headers:Object.assign({'Content-Type':'application/json'},h), body:JSON.stringify(body||{}) });
-    }catch(netErr){ return DeviceCore.parseSyncResponse({ status:'provider_unavailable', error:'network' }); }
-    if(r.status===401||r.status===403){ return DeviceCore.parseSyncResponse({ status:'authorization_required' }); }
-    if(r.status===429){ return DeviceCore.parseSyncResponse({ status:'rate_limited' }); }
-    var d=null; try{ d=await r.json(); }catch(_){ d=null; }
