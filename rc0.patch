-// ── F44/F1 — STARTING STRENGTH UI-laag (deterministisch, geen AI) ──────────
-// Config: welke referentielift → welke norm (voor afleiding) + onder welke exercise_id's
-// het door de sporter opgegeven 1RM wordt bewaard. Meerdere store-id's omdat dezelfde lift
-// bij deze sporter zowel onder een legacy-slug ('bench') als een canonical TK-id
-// ('TK-000019') kan worden gelogd — getOneRM() vindt het dan hoe dan ook terug. Deadlift
-// heeft (bewust) geen LIFT_NORM → wel opslaan als VERSTREKT, niet afleiden.
-const REFERENCE_LIFTS = [
-  {key:'bench',    label:'Bench press',    syn:['bench','benchpress','bankdruk','bankdrukken','bp'],                 normKey:'bench',         storeIds:['bench','TK-000019']},
-  {key:'squat',    label:'Squat',          syn:['squat','backsquat','back squat','kniebuig','kniebuiging'],          normKey:'backsquat',     storeIds:['backsquat','TK-000038']},
-  {key:'deadlift', label:'Deadlift',       syn:['deadlift','dl','dead lift','trekken'],                              normKey:null,            storeIds:['deadlift','TK-000024']},
-  {key:'ohp',      label:'Overhead press', syn:['overhead press','overhead','ohp','shoulder press','schouderdruk','schouderdrukken','press'], normKey:'shoulderpress', storeIds:['shoulderpress','TK-000030']}
-];
-// Deterministische vrije-tekst-parser: "Bench 80 voor 5", "Squat 100 x 5", "Deadlift 140x3",
-// "bankdrukken 80 kg 5 reps". Eerste getal = gewicht, tweede = reps; alleen gewicht → 1RM (reps=1).
-// Geen AI. Geen fuzzy identity — alleen expliciete synoniemen uit REFERENCE_LIFTS.
-function parseReferenceLifts(text){
-  const out=[];
-  if(!text||typeof text!=='string')return out;
-  // Bescherm decimaal-komma's (82,5) vóór het splitsen, zodat komma óók als scheidingsteken
-  // tussen liften kan dienen ("Bench 80, Squat 100") zonder 82,5 te breken.
-  text=text.replace(/(\d),(\d)/g,'$1.$2');
-  // splits op nieuwe regels, komma's en puntkomma's
-  const segs=text.split(/[\n,;]+/).map(s=>s.trim()).filter(Boolean);
-  const seen=new Set();
-  segs.forEach(seg=>{
-    const low=' '+seg.toLowerCase()+' ';
-    // langste synoniem eerst zodat 'overhead press' vóór 'press' matcht
-    let hit=null, hitLen=-1;
-    REFERENCE_LIFTS.forEach(cfg=>{
-      cfg.syn.forEach(s=>{
-        if(low.indexOf(' '+s+' ')>=0 || low.indexOf(' '+s)>=0 && low.indexOf(s+' ')>=0){
-          if(s.length>hitLen && new RegExp('(^|[^a-z])'+s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'([^a-z]|$)').test(low)){ hit=cfg; hitLen=s.length; }
-        }
-      });
-    });
-    if(!hit||seen.has(hit.key))return;
-    const nums=(seg.match(/\d+(?:[.,]\d+)?/g)||[]).map(n=>parseFloat(n.replace(',','.')));
-    if(!nums.length)return;
-    const weight=nums[0];
-    const reps=nums.length>=2?Math.round(nums[1]):1;   // alleen gewicht → 1RM (reps=1)
-    if(!(weight>0)||!(reps>0)||reps>30)return;
-    seen.add(hit.key);
-    out.push({key:hit.key,weight:weight,reps:reps});
-  });
-  return out;
-}
-// Combineer VERSTREKT (opgegeven) en GESCHAT (afgeleid) voor de 4 referentieliften.
-// Pure: hergebruikt estimateStartingStrength (norm-liften) + epley1RMRaw (deadlift zonder norm).
-function computeStartingStrength(entries){
-  const refs=[], noNorm=[];
-  (entries||[]).forEach(en=>{
-    const cfg=REFERENCE_LIFTS.find(l=>l.key===en.key); if(!cfg)return;
-    const w=parseFloat(en.weight), reps=parseInt(en.reps,10);
-    if(!(w>0)||!(reps>0)||reps>30)return;
-    if(cfg.normKey)refs.push({lift:cfg.normKey,weight:w,reps:reps});
-    else noNorm.push({key:cfg.key,weight:w,reps:reps});
-  });
-  const est=estimateStartingStrength(refs);
-  const provided=[], derived=[];
-  refs.forEach(r=>{
-    const cfg=REFERENCE_LIFTS.find(l=>l.normKey===r.lift); const p=est.provided[r.lift];
-    if(cfg&&p)provided.push({key:cfg.key,label:cfg.label,est1RM:p.est1RM,weight:p.weight,reps:p.reps,storeIds:cfg.storeIds});
-  });
-  noNorm.forEach(n=>{
-    const cfg=REFERENCE_LIFTS.find(l=>l.key===n.key); let e1rm=null;
-    try{e1rm=Math.round(epley1RMRaw(n.weight,n.reps));}catch(_){}
-    if(cfg&&e1rm>0)provided.push({key:cfg.key,label:cfg.label,est1RM:e1rm,weight:n.weight,reps:n.reps,storeIds:cfg.storeIds});
-  });
-  REFERENCE_LIFTS.forEach(cfg=>{
-    if(!cfg.normKey)return;
-    if(provided.some(p=>p.key===cfg.key))return;
-    const d=est.derived[cfg.normKey];
-    if(d){ const fromCfg=REFERENCE_LIFTS.find(l=>l.normKey===d.fromLift);
-      derived.push({key:cfg.key,label:cfg.label,est1RM:d.est1RM,fromLabel:fromCfg?fromCfg.label:d.fromLift}); }
-  });
-  return {provided,derived};
-}
