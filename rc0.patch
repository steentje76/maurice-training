-// -- Generieke switch-helper --------------------------------------------
-function initSwitch(id, storageKey, defaultOn, onChange){
-  const el=document.getElementById(id);
-  if(!el)return;
-  const stored=localStorage.getItem(storageKey);
-  const on = stored===null ? defaultOn : stored==='1';
-  el.setAttribute('aria-checked', on?'true':'false');
-  el.onclick=()=>{
-    const now=el.getAttribute('aria-checked')==='true';
-    const next=!now;
-    el.setAttribute('aria-checked', next?'true':'false');
-    localStorage.setItem(storageKey, next?'1':'0');
-    if(onChange)onChange(next);
-  };
-}
-function isSettingOn(storageKey, defaultOn){
-  const stored=localStorage.getItem(storageKey);
-  return stored===null ? defaultOn : stored==='1';
-}
