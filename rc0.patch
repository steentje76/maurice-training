-// Gewichtsfactor bij een recovery-RPE-delta: exact de working_weight.v1-verhouding (Brzycki) die de
-// programmaflow ook gebruikt — een lagere doel-RPE ⇒ lager gewicht. oneRM-onafhankelijk (valt weg in de
-// ratio), dus puur uit reps + rpeDelta. Geen nieuwe sportlogica; hergebruikt CalcCore.calculateWorkingWeight.
-function recoveryWeightFactor(reps, rpeDelta){
-  if(!rpeDelta) return 1;
-  const r=parseInt(reps)||8;
-  const base=CalcCore.calculateWorkingWeight(1000, r, 8);
-  const adj=CalcCore.calculateWorkingWeight(1000, r, Math.max(5,Math.min(10, 8+rpeDelta)));
-  if(!base||!adj) return 1;
-  return adj/base;
-}
