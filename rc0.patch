-<!-- ═══ PRIVACY (Hoofdstuk 6, Scherm 9.6) — Sprint 2 ═══ -->
-<div class="scr" id="s-privacy">
-  <div class="hdr">
-    <div class="hdr-row">
-      <div><div class="hdr-title" role="heading" aria-level="1">Privacy</div><div class="hdr-sub">Wat we opslaan en waarom</div></div>
