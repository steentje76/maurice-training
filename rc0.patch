-// "73,5" én "73.5" → 73.5. Voorkomt de dataverlies-bug waarbij een komma-invoer stil
-// verkeerd werd geïnterpreteerd (73,5 → 73 of erger). Ongeldige invoer → NaN, zodat de
-// aanroeper het als 'geen waarde' behandelt en NOOIT een foutief getal opslaat.
-function numNL(v){
-  if(v==null)return NaN;
-  const s=String(v).trim().replace(',', '.');
-  if(s===''|| !/^-?\d*\.?\d+$/.test(s))return NaN;
-  return parseFloat(s);
-}
-// Genormaliseerde numerieke STRING voor opslag (komma→punt), zodat elke downstream parseFloat
-// klopt. Lege invoer blijft leeg; niet-numerieke invoer wordt niet als getal opgeslagen.
-function normNumStr(v){
-  if(v==null)return '';
-  const s=String(v).trim();
-  if(s==='')return '';
-  return isNaN(numNL(s)) ? '' : s.replace(',', '.');
-}
