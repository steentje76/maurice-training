-    return '<div class="tk-weather-chip" style="background:var(--g1);border-radius:10px;padding:8px 12px;margin:6px 14px;font-size:12px;color:var(--g4);font-weight:600">'+
-      '<div style="font-size:10px;text-transform:uppercase;letter-spacing:.5px;opacity:.7;margin-bottom:3px">'+label+'</div>'+
-      '<div style="display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center">'+
-      parts.map(function(p){return '<span>'+p+'</span>';}).join('<span style="opacity:.35">·</span>')+'</div></div>';
-  }
-  // Premium Home-kaart (beslissingscontext: "ga ik vandaag trainen? buiten?"). Toont vollediger dan de
-  // trainingschip, met "Laatste update" + gecachet/verouderd-markering. Geen verzonnen waarden.
-  function renderHomeCard(res){
-    var w=res&&res.data, outdoor=(res&&res.variant==='outdoor');
-    var label = outdoor ? '🌤 Weer vandaag' : '🏋 Trainingsomgeving';
-    var big = '🌡 '+_nl(w.temperature_c)+'°C';
-    var sub=[];
-    if(outdoor && w.feels_like_c!=null) sub.push('voelt als '+_nl(w.feels_like_c)+'°C');
-    if(w.humidity_pct!=null) sub.push('💧 '+_nl(w.humidity_pct)+'%');
