-// v3.3.56 Exercise Intelligence Layer — presentatie-only helpers.
-// Leest uitsluitend bestaande oefeningdata (id/naam) + bestaande engine-data (prevS,
-// computeProgression). Raakt logSet/toggleSetDone/PR/one_rm/RPE/offline NIET aan.
-function _intelNorm(s){return String(s||'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();}
-let _intelById=null,_intelByName=null;
-function _intelBuildIndex(){
-  _intelById={};_intelByName={};
-  const list=(typeof EXERCISE_ASSETS!=='undefined'&&Array.isArray(EXERCISE_ASSETS))?EXERCISE_ASSETS:[];
-  list.forEach(a=>{
-    // Governance-gate: alleen goedgekeurd + hoge zekerheid + actief + met poster wordt getoond.
-    if(!(a&&a.approved===true&&a.confidence==='high'&&a.status==='active'&&a.poster))return;
-    (a.exercise_ids||[]).forEach(id=>{if(id&&!_intelById[id])_intelById[id]=a;});
-    (a.match_names||[]).forEach(n=>{const k=_intelNorm(n);if(k&&!_intelByName[k])_intelByName[k]=a;});
-  });
-}
-function getExerciseAsset(ex){
-  if(!ex)return null;
-  // F0.6 Fase 6: voor canonical Gym-oefeningen (TK-XXXXXX) EX_CATALOG.intelligence gebruiken
-  // (206/206 gevuld, bevestigd F0.3) i.p.v. alleen de bestaande, losstaande 13-entry
-  // EXERCISE_ASSETS-set. Vorm hier aangepast aan wat buildIntelligenceCard() al verwacht
-  // (.technique[], .mistakes[], .poster) — geen wijziging aan buildIntelligenceCard() nodig.
-  if(typeof ex.id==='string'&&ex.id.indexOf('TK-')===0&&typeof ExerciseCatalogService!=='undefined'){
-    try{
-      const c=ExerciseCatalogService.byId(ex.id);
-      if(c&&c.intelligence){
-        let posterUrl=null;
-        try{if(typeof ExerciseAssetProvider!=='undefined')posterUrl=ExerciseAssetProvider.poster(ex.id)||null;}catch(e){}
-        return {technique:c.intelligence.cues||[], mistakes:c.intelligence.mistakes||[], poster:posterUrl};
-      }
-    }catch(e){}
-  }
-  if(_intelById===null)_intelBuildIndex();
-  return _intelById[ex.id]||_intelByName[_intelNorm(ex.naam||ex.name)]||null;
-}
-function _intelInjectPoster(exId){
-  const el=document.getElementById('intel-poster-'+exId);
-  if(el&&!el.firstChild&&el.dataset&&el.dataset.src){
-    const img=new Image();img.className='intel-img';img.loading='lazy';img.alt='Techniek';img.src=el.dataset.src;
-    el.appendChild(img);
-  }
-}
-function toggleIntelCard(exId){
-  const c=document.getElementById('intel-'+exId);if(!c)return;
-  const open=c.classList.toggle('open');
-  const btn=c.querySelector('.intel-toggle');if(btn)btn.setAttribute('aria-expanded',String(open));
-  if(open)_intelInjectPoster(exId);
-}
