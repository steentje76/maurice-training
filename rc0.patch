-<script>
-// ── OPEN-METEO RUNTIME — additive context, NOOIT een blocker voor training ──
-// Keten: geolocation-consent → WeatherCore.buildOpenMeteoRequest → fetch →
-// WeatherCore.normalizeWeather(OPENMETEO_MAP) → canoniek → chip. Elke fout → null (weer uit).
-// Geen eigen weer-parsing, geen key hardcoded, geen fabricatie (geen verzonnen 0°C).
-var TKWeather = (function(){
-  var _cache = {}; // key: round2(lat)|round2(lng)|UTC-uur → canoniek weer
-  function _round2(v){ return Math.round(v*100)/100; }
-  function _hourKey(lat,lng){
-    var d=new Date();
-    var hk=d.getUTCFullYear()+'-'+(d.getUTCMonth()+1)+'-'+d.getUTCDate()+'-'+d.getUTCHours();
-    return _round2(lat)+'|'+_round2(lng)+'|'+hk;
-  }
-  function applies(ctx){ try{ return (typeof WeatherCore!=='undefined')?WeatherCore.weatherApplies(ctx):false; }catch(e){ return false; } }
-  function fetchWeather(lat,lng){
-    return new Promise(function(resolve){
-      try{
-        if(typeof WeatherCore==='undefined'){ resolve(null); return; }
-        var key=_hourKey(lat,lng);
-        if(_cache[key]){ resolve({data:_cache[key],cached:true}); return; } // cache-hit binnen het uur
-        var req=WeatherCore.buildOpenMeteoRequest(lat,lng,{});
-        if(!req){ resolve(null); return; }
-        var ctrl=(typeof AbortController!=='undefined')?new AbortController():null;
-        var to=setTimeout(function(){ try{ctrl&&ctrl.abort();}catch(_){} },8000);
-        fetch(req.url, ctrl?{signal:ctrl.signal}:{}).then(function(r){
-          clearTimeout(to);
-          if(!r||!r.ok) return null;
-          return r.json();
-        }).then(function(json){
-          if(!json){ resolve(null); return; }
-          var canon=WeatherCore.normalizeWeather(json, WeatherCore.OPENMETEO_MAP, {receivedAt:Date.now()});
-          // alleen geldig als temperatuur bruikbaar is — anders weer uit (geen verzonnen waarde)
-          if(!canon || canon.temperature_c==null || (canon.quality&&canon.quality.temperature_c==='invalid')){ resolve(null); return; }
-          _cache[key]=canon;
-          resolve({data:canon,cached:false});
-        }).catch(function(){ clearTimeout(to); resolve(null); });
-      }catch(e){ resolve(null); }
-    });
-  }
-  // Coördinaten (consent-gated). Fout → gestructureerde reden (denied/unsupported/unavailable),
-  // nooit gokken. Reden stuurt de UI-state (geweigerd vs. tijdelijk niet beschikbaar).
-  function getCoords(){
-    return new Promise(function(resolve){
-      try{
-        if(!navigator.geolocation){ resolve({error:'unsupported'}); return; }
-        navigator.geolocation.getCurrentPosition(
-          function(pos){ resolve({lat:pos.coords.latitude,lng:pos.coords.longitude}); },
-          function(err){ resolve({error:(err&&err.code===1)?'denied':'unavailable'}); },
-          {timeout:8000,maximumAge:1800000,enableHighAccuracy:false}
-        );
-      }catch(e){ resolve({error:'unavailable'}); }
-    });
-  }
-  // De indoor/outdoor-regel bepaalt de VARIANT (welke context), niet de zichtbaarheid.
-  function variantFor(ctx){ return applies(ctx) ? 'outdoor' : 'indoor'; }
-  // Centrale consent-vlag (soft opt-in). De browser beheert de echte locatiepermissie; deze vlag
-  // onthoudt dat de gebruiker de weer-functie heeft aangezet zodat Home/Training hem automatisch tonen.
-  var OPTIN_KEY='tk_weather_optin';
-  function isEnabled(){ try{ return localStorage.getItem(OPTIN_KEY)==='1'; }catch(e){ return false; } }
-  function enable(){ try{ localStorage.setItem(OPTIN_KEY,'1'); }catch(e){} }
-  function disable(){ try{ localStorage.removeItem(OPTIN_KEY); }catch(e){} for(var k in _cache){ if(_cache.hasOwnProperty(k)) delete _cache[k]; } }
-  // Centrale toegang: Home én Training halen hun weer hier op → gedeelde cache, geen dubbele fetch.
-  // Retourneert ALTIJD een object: {data|null, variant, cached, receivedAt, reason}. Elke fout → data null.
-  function forContext(ctx){
-    return new Promise(function(resolve){
-      getCoords().then(function(c){
-        if(!c || c.error){ resolve({data:null, variant:variantFor(ctx), cached:false, receivedAt:null, reason:(c&&c.error)||'unavailable'}); return; }
-        fetchWeather(c.lat,c.lng).then(function(res){
-          if(res && res.data){
-            var rc=(res.data.provenance&&res.data.provenance.receivedAt)||null;
-            resolve({data:res.data, variant:variantFor(ctx), cached:!!res.cached, receivedAt:rc, reason:null});
-          } else { resolve({data:null, variant:variantFor(ctx), cached:false, receivedAt:null, reason:'unavailable'}); }
-        });
-      });
-    });
-  }
-  function _nl(v,d){ d=d||1; return (v==null)?'—':String(Math.round(v*d)/d).replace('.',','); }
-  function _hhmm(ts){ if(!ts) return ''; try{ var d=new Date(ts); return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }catch(e){ return ''; } }
-  function _stale(ts){ if(!ts) return false; try{ return (Date.now()-ts) > 3600000; }catch(e){ return false; } }
-  // Compacte context-chip (Training-scherm). INDOOR: 🌡 temp · 💧 vocht · 🧭 luchtdruk (🌧 alleen indien >0).
-  // OUTDOOR: 🌡 temp (voelt als) · 💧 vocht · 💨 wind · 🌧 neerslag · 🧭 luchtdruk.
-  function renderChip(w, variant){
-    if(!w || w.temperature_c==null) return '';
