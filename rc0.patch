-async function coldStartEstimate(exId){
-  if(LIFT_NORMS[exId]!=null){
-    const bw=await latestBodyweight();
-    if(!bw)return null;
-    const waarde=expected1RM(exId,bw,atleet.leeftijd,atleet.niveau);
-    if(!waarde)return null;
-    return {waarde,bron:'lichaamsgewicht + niveau'};
-  }
-  const exObj=exercises.find(e=>e.id===exId);
-  if(exObj?.ratio_anchor && exObj?.ratio_factor){
-    const anchorId=exObj.ratio_anchor;
-    const ss=await sbGet('sessions','&exercise_id=eq.'+anchorId+'&weight=not.is.null&reps=not.is.null&order=date.desc,created_at.desc&limit=30');
-    const est=weightedEst1RM(ss);
