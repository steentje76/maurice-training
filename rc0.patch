-// Eén centrale, data-driven mapper van cardio-invoer naar een 'sessions'-rij.
-// Leest uitsluitend cfg.rowMap uit — een nieuw cardiotype toevoegen aan CARDIO_TYPES
-// werkt hier automatisch mee, zonder deze functie aan te passen (geen switch/case meer).
-function cardioDataToRow(cardioType, d){
-  const cfg=CARDIO_TYPES[cardioType]||CARDIO_TYPES.rowing;
-  const row={};
-  const notes=[];
-  cfg.fields.forEach(f=>{
-    const spec=cfg.rowMap && cfg.rowMap[f];
-    if(!spec)return;
-    const raw=d[f];
-    if(raw===undefined||raw===null||raw==='')return;
-    if(spec.col==='extraNote'){
-      notes.push(spec.template?spec.template(raw,d):String(raw));
-      return;
-    }
-    // KOMMA-VEILIG: rauwe cardio-invoer (type=text) kan NL-komma bevatten. parseFloat("5,5")=5 → dataverlies.
-    // Inline komma→punt-normalisatie (zelf-bevattend, geen externe helper). Tijd/split/pace lopen al via parseTime-wrappers.
-    let v = spec.parse==='int'?parseInt(String(raw).replace(',','.'),10):spec.parse==='float'?parseFloat(String(raw).replace(',','.')):raw;
-    // F3.6: weiger niet-eindige (NaN/Infinity) én negatieve cardio-waarden vóór actual-write.
-    // Zo belandt er nooit een corrupte/onmogelijke waarde in een sessions-row (CardioCore blijft bron van waarheid).
-    if(spec.parse!=='string'&&(!isFinite(v)||v<0))return;
-    if(spec.transform)v=spec.transform(v);
-    row[spec.col]=v;
-  });
-  // Handmatige per-interval splits zijn ECHTE invoer (niet herleidbaar uit tijd+afstand zoals
-  // auto-splits) → compact meebewaren in de note (geen schemakolom). Formaat: splits:q=sec,...
-  // Auto-splits worden NIET bewaard: ze zijn deterministisch herberekenbaar uit tijd+afstand.
-  if(d.splitMode==='handmatig' && d.splits && typeof d.splits==='object'){
-    const sp=Object.keys(d.splits).filter(q=>d.splits[q]!=null&&d.splits[q]!=='').sort((a,b)=>a-b).map(q=>q+'='+d.splits[q]);
-    if(sp.length)notes.push('splits:'+sp.join(','));
-  }
-  if(notes.length)row.extraNote=notes.join(' | ');
-  // Zwemmen: pace_sec is een afgeleide kolom (geen los invoerveld), vandaar los van rowMap.
-  if(cfg.derivePaceSec&&row.distance&&row.time_str){
-    const sec=parseTimeToSec(row.time_str);
-    row.pace_sec=(sec&&row.distance)?Math.round((sec/row.distance)*100):null;
-  }
-  row.rpe = row.rpe!==undefined?row.rpe:null;
-  return row;
-}
