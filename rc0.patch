-// Korte, deterministische "wat + waarom"-melding bij een recovery-aanpassing (geen AI). Toont niets als er niets aangepast is.
-function recoveryAdjustToast(adj){
-  if(!adj || (!adj.setsDelta && !adj.rpeDelta)) return;
-  const parts=[];
-  if(adj.setsDelta) parts.push((adj.setsDelta>0?'+':'')+adj.setsDelta+' set');
-  if(adj.rpeDelta) parts.push('RPE '+(adj.rpeDelta>0?'+':'')+adj.rpeDelta);
