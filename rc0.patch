-// ── ÉÉN MEDIA-OWNER ───────────────────────────────────────────────────────
-// resolveExerciseMedia: één beslissing voor álle renderers. Prioriteit:
-// 1) lokale MoveKit .mp4 (ex.video / ExerciseAssetProvider) 2) YouTube (ex.yt) 3) poster 4) niets.
-// Zo blijft een bestaande MoveKit-video niet onzichtbaar doordat de UI alleen yt las.
-function resolveExerciseMedia(ex){
-  ex=ex||{};
-  // MOVEKIT PRIMAIR (gebruikerswens): MoveKit-video wint ALTIJD van YouTube.
-  // Resolutie via de centrale ExerciseAssetProvider — naam/catalog-gebaseerd (_slug), zodat MoveKit
-  // óók resolveert voor legacy/gym-oefeningen zonder expliciet video-veld. YouTube = alleen fallback.
-  let mp4=ex.video||null;
-  if(!mp4 && typeof ExerciseAssetProvider!=='undefined'){
-    try{
-      const _id=ex.canonicalId||ex.id||null;
-      if(_id){
-        if(ExerciseAssetProvider.has && ExerciseAssetProvider.has(_id,'video')) mp4=ExerciseAssetProvider.resolve(_id,'video');
-        else if(ExerciseAssetProvider.hasVideo && ExerciseAssetProvider.hasVideo(_id)){ const v=ExerciseAssetProvider.video(_id); mp4=v?v.file:null; }
-      }
-    }catch(e){}
-  }
-  const yt=ex.yt||null;
-  let poster=null;
-  try{ if(typeof movekitPosterFor==='function') poster=movekitPosterFor(ex)||null; }catch(e){}
-  // Contract: { type, kind(back-compat), src, source, available, provenance, poster }
-  if(mp4)    return { type:'movekit', kind:'mp4',    src:mp4,    source:'movekit', available:true,  provenance:{provider:'movekit', method:'local'},  poster:poster };
-  if(yt)     return { type:'youtube', kind:'yt',     src:yt,     source:'youtube', available:true,  provenance:{provider:'youtube', method:'embed'},  poster:poster };
-  if(poster) return { type:'poster',  kind:'poster', src:poster, source:'movekit', available:true,  provenance:{provider:'movekit', method:'poster'} };
-  return       { type:'none',    kind:'none',   src:null,   source:null,      available:false, provenance:null };
-}
-// UNIVERSELE RECOVERY voor de Guided prescription: past de DecisionCore-aanpassing toe op het GW-plan
-// (sets + gewicht), op KOPIEËN. Idempotent — één keer bij start; GW bewaart het aangepaste plan in
-// tk_gw_active en resume herstelt dat (geen her-toepassing). Zelfde beslissingsbron als alle routes.
-function applyRecoveryToGuidedPlan(plan, adj){
-  if(!plan || !Array.isArray(plan.items) || !adj || (!adj.setsDelta && !adj.rpeDelta)) return plan;
-  plan.items=plan.items.map(it=>{
-    const out={...it};
-    if(out.sets!=null && isFinite(parseInt(out.sets))) out.sets=Math.max(1, parseInt(out.sets)+(adj.setsDelta||0));
-    if(out.weight!=null && isFinite(parseFloat(out.weight)) && adj.rpeDelta){
-      out.weight=roundKg(parseFloat(out.weight)*recoveryWeightFactor(out.reps||it.reps, adj.rpeDelta));
-      out._rxAdjusted=true;
-    }
-    return out;
-  });
-  return plan;
-}
