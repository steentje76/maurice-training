-.tpv2-d-h.warn{color:#c0392b}
-.tpv2-li{display:flex;gap:8px;font-size:13px;color:var(--dark);line-height:1.5;margin:5px 0}
-.tpv2-li .ic{flex-shrink:0}
-.tpv2-d-say{background:var(--g1);border-radius:12px;padding:11px 13px;font-size:13px;line-height:1.5;color:var(--dark)}
