-      <div class="intel-poster" id="intel-poster-${ex.id}" data-src="${a.poster}"></div>
-      ${personalCoach?`<div class="intel-sec"><div class="intel-sec-lbl accent">Voor jou vandaag</div><div class="intel-coach">${escHtml(personalCoach)}</div></div>`:''}
-      ${(tech||mist)?`<div class="intel-sec-lbl" style="margin-top:2px">Algemene techniek</div>`:''}
-      ${tech?`<div class="intel-sec"><div class="intel-sec-lbl">Uitvoering</div><ul class="intel-list">${tech}</ul></div>`:''}
-      ${mist?`<div class="intel-sec"><div class="intel-sec-lbl warn">Veelgemaakte fouten</div><ul class="intel-list">${mist}</ul></div>`:''}
-    </div>
