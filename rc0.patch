-async function refreshMuscleHeatmap(){
-  const weekAgo = new Date();
-  weekAgo.setDate(weekAgo.getDate()-7);
-  const dateStr = weekAgo.toISOString().split('T')[0];
-  const ss = await sbGet('sessions','&date=gte.'+dateStr+'&weight=not.is.null&sets=not.is.null&reps=not.is.null');
-  const setsBySvgId = {};
-  ss.forEach(s=>{
-    const names = getExerciseMuscles(s.exercise_id);
-    const svgIds = muscleNamesToSvgIds(names);
-    const setCount = s.sets||1;
-    svgIds.forEach(id=>{ setsBySvgId[id] = (setsBySvgId[id]||0) + setCount; });
-  });
-  renderMuscleHeatmap('muscle-heatmap-container', setsBySvgId);
-}
-
-function getExerciseMuscles(exId){
-  const ex=exercises.find(e=>e.id===exId);
-  if(!ex) return [];
-  return [...(ex.muscle_primary||[]),...(ex.muscle_secondary||[])];
-}
