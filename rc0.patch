-  backup.atleet = atleet;
-  backup.customTrainings = customTrainings;
-  downloadFile(JSON.stringify(backup,null,2), 'trainingskompas_backup_'+td()+'.json', 'application/json');
-  toast('Volledige backup gedownload');
