-.wb4-setstep button{width:32px;height:32px;border-radius:9px;border:1px solid var(--g1);background:var(--g1);color:var(--dark);font-size:18px;font-weight:800;cursor:pointer;font-family:var(--f)}
-.wb4-setstep b{font-size:15px;min-width:18px;text-align:center}
-.wb4-schema{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
-.wb4-chip2{font-size:11px;font-weight:700;color:var(--g4);background:var(--g1);border-radius:8px;padding:4px 9px}
-.wb4-wtnote{font-size:11px;font-weight:600;color:var(--g4);margin-top:8px;font-style:italic}
