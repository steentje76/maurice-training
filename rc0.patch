-      personalCoach=buildPrescriptionContract(ex, prevS, rxWeight).coaching||'';
-    }
-  }catch(e){}
-  const tech=(a.technique||[]).slice(0,3).map(x=>`<li>${escHtml(x)}</li>`).join('');
-  const mist=(a.mistakes||[]).slice(0,2).map(x=>`<li>${escHtml(x)}</li>`).join('');
-  return `<div class="intel-card${first?' open':''}" id="intel-${ex.id}">
-    <button type="button" class="intel-toggle" onclick="toggleIntelCard('${ex.id}')" aria-expanded="${first?'true':'false'}">
-      <span class="intel-toggle-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-10.9 6.7L4 19.5l1.3-4.1A7.5 7.5 0 1 1 20 11.5Z"/></svg></span>
