-// ISO-weekdag: 1=maandag ... 7=zondag
-function isoWeekday(dateStr){
-  const wd=new Date(dateStr+'T00:00:00').getDay();
-  return wd===0?7:wd;
-}
-function addDaysStr(dateStr,n){
-  // v3.3.15 BUGFIX: was toISOString() (UTC) — rolde in NL-tijdzone (UTC+1/+2) terug naar
-  // de vorige dag, zelfde bugklasse als eerder gefixt in td(). Bij schemaType 'weekdagen'
-  // riep computeBlockPlannedDates() dit herhaald aan in een while-lus tot de weekdag klopte;
-  // omdat de datum daardoor nooit echt vooruitschoof, liep die lus oneindig door — de
-  // waargenomen "Programma opslaan blijft hangen, knop verandert niet"-freeze.
-  const d=new Date(dateStr+'T00:00:00');
-  d.setDate(d.getDate()+n);
-  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
-}
-// Bepaalt de geplande kalenderdatum per blok. Bij 'weekdagen' wordt door de gekozen
-// weekdagen gecycled vanaf startDate; bij 'interval' wordt gelijkmatig gespreid o.b.v.
-// dagenPerWeek. Deze datum is een startvoorstel — welk blok "volgende" is wordt elders
-// altijd bepaald door completed_at, niet door deze datum (gemiste dagen schuiven door).
-function computeBlockPlannedDates(startDate,blockCount,schemaType,weekdagen,dagenPerWeek){
-  const dates=[];
-  if(schemaType==='weekdagen'&&weekdagen&&weekdagen.length){
-    const wd=[...weekdagen].sort((a,b)=>a-b);
-    let cursor=startDate,wdIdx=0;
-    for(let i=0;i<blockCount;i++){
-      const target=wd[wdIdx%wd.length];
-      while(isoWeekday(cursor)!==target){cursor=addDaysStr(cursor,1);}
-      dates.push(cursor);
-      cursor=addDaysStr(cursor,1);
-      wdIdx++;
-    }
-  }else{
-    const spacing=Math.max(1,Math.round(7/(dagenPerWeek||2)));
-    for(let i=0;i<blockCount;i++){dates.push(addDaysStr(startDate,i*spacing));}
-  }
-  return dates;
-}
