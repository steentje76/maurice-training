-// ══════════════════════════════════════════════════════════
-// HRV-BASELINE — Sprint 5.7.1 (RB: HRV op absolute drempels -> persoonlijke baseline)
-// Vervangt de vaste ms-drempels (24/18/14) door de Plews/Buchheit SWC-methode:
-// Ln-RMSSD-transformatie, 7-daags rollend gemiddelde t.o.v. een persoonlijke
-// baseline (Smallest Worthwhile Change = gemiddelde ± 0,5×SD).
-// Bronnen: Frontiers in Sports & Active Living 2025 (10.3389/fspor.2025.1578478) —
-// SWC=mean±0.5SD van Ln-RMSSD 7d-rollend-gemiddelde; TrainingPeaks/Kiviniemi-
-// cyclistenstudie — 2-4 weken baselineperiode, SD van HRV-metingen als bron voor de
-// SWC; athletedata.health (2026) — minimaal 2 weken baseline (4 beter), ≥15% daling
-// t.o.v. rollend gemiddelde als apart ernst-signaal, ≥4-5 metingen/week nodig voor
-// een betrouwbaar weekgemiddelde. Leeftijd is bewust GEEN aparte factor: de
-// literatuur bevestigt dat een persoonlijke baseline leeftijdsverschillen in
-// absolute HRV al zelf opvangt (zie sprint-overleg) — een aparte leeftijdscorrectie
-// zou dubbel corrigeren. Puur informatief, past nooit automatisch iets aan.
-// ══════════════════════════════════════════════════════════
-const HRV_BASELINE_MIN_DAYS = 14;   // ondergrens voorlopige baseline (referentiefase eronder)
-const HRV_BASELINE_FULL_DAYS = 28;  // grens voor een volledige/stabiele baseline
-const HRV_BASELINE_MIN_N = 4;       // minimum aantal metingen, ongeacht dagen verstreken
-const HRV_SWC_MULTIPLIER = 0.5;     // Plews et al. — smallest worthwhile change
-const HRV_SEVERE_DROP_PCT = 0.15;   // athletedata.health — apart ernst-signaal
-
-function lnRmssd(v){return (typeof v==='number' && v>0) ? Math.log(v) : null;}
-
-// Bouwt de persoonlijke baseline uit historische hrv_log-rijen ({date,hrv}-vorm).
-// fase: 'referentie' (<14 dagen of <4 metingen — geen claim mogelijk), 'voorlopig'
-// (>=14 dagen), 'volledig' (>=28 dagen).
-function hrvBaseline(hdRows, refDate){
-  const ref = refDate ? new Date(refDate) : new Date();
-  const rows = (hdRows||[])
-    .filter(r=>r && r.hrv && r.date)
-    .map(r=>({date:new Date(r.date), hrv:r.hrv, ln:lnRmssd(r.hrv)}))
-    .filter(r=>r.ln!=null && !isNaN(r.date.getTime()) && r.date<=ref);
-  if(!rows.length) return {ready:false, fase:'referentie', n:0, days:0};
-  rows.sort((a,b)=>a.date-b.date);
-  const days = Math.max(0, Math.round((ref-rows[0].date)/86400000));
-  const n = rows.length;
-  if(days < HRV_BASELINE_MIN_DAYS || n < HRV_BASELINE_MIN_N){
-    return {ready:false, fase:'referentie', n, days};
-  }
-  const meanLn = rows.reduce((s,r)=>s+r.ln,0)/n;
-  const variance = rows.reduce((s,r)=>s+Math.pow(r.ln-meanLn,2),0)/n;
-  const sdLn = Math.sqrt(variance);
-  const meanRaw = rows.reduce((s,r)=>s+r.hrv,0)/n;
-  const fase = days>=HRV_BASELINE_FULL_DAYS ? 'volledig' : 'voorlopig';
-  return {ready:true, fase, n, days, meanLn, sdLn, meanRaw, swc:HRV_SWC_MULTIPLIER*sdLn};
-}
-
-// 7-daags rollend gemiddelde t.o.v. refDate. Bij <4 metingen in de afgelopen 7 dagen
-// (te weinig voor een betrouwbaar weekgemiddelde) valt terug op de laatste losse
-// meting — nooit een crash, wel lagere n/bron-transparantie in de output.
-function hrvRollingRecent(hdRows, refDate){
-  const ref = refDate ? new Date(refDate) : new Date();
-  const rows = (hdRows||[])
-    .filter(r=>r && r.hrv && r.date)
-    .map(r=>({date:new Date(r.date), hrv:r.hrv, ln:lnRmssd(r.hrv)}))
-    .filter(r=>r.ln!=null && !isNaN(r.date.getTime()) && r.date<=ref);
-  if(!rows.length) return null;
-  rows.sort((a,b)=>b.date-a.date);
-  const sevenDaysAgo=new Date(ref.getTime()-7*86400000);
-  const last7=rows.filter(r=>r.date>=sevenDaysAgo);
-  if(last7.length>=HRV_BASELINE_MIN_N){
-    const meanLn=last7.reduce((s,r)=>s+r.ln,0)/last7.length;
-    const meanRaw=last7.reduce((s,r)=>s+r.hrv,0)/last7.length;
-    return {meanLn, meanRaw, n:last7.length, bron:'7d-gemiddelde'};
-  }
-  const latest=rows[0];
-  return {meanLn:latest.ln, meanRaw:latest.hrv, n:1, bron:'laatste meting'};
-}
-
-// Classificeert vandaag t.o.v. de eigen baseline. st: 'g' (binnen/boven SWC),
-// 'o' (onder SWC — smallest worthwhile change), 'r' (>=15% daling, apart ernst-
-// signaal), 'ref' (referentiefase, geen persoonlijke claim mogelijk).
-function hrvStPersonal(hdRows, refDate){
-  const baseline=hrvBaseline(hdRows, refDate);
-  if(!baseline.ready)return {st:'ref', baseline, recent:null, drop:null};
-  const recent=hrvRollingRecent(hdRows, refDate);
-  if(!recent)return {st:'ref', baseline, recent:null, drop:null};
-  const drop=(baseline.meanRaw-recent.meanRaw)/baseline.meanRaw;
-  if(drop>=HRV_SEVERE_DROP_PCT)return {st:'r', baseline, recent, drop};
-  if(recent.meanLn < baseline.meanLn-baseline.swc)return {st:'o', baseline, recent, drop};
-  return {st:'g', baseline, recent, drop};
-}
-
-// HRV-dagfactor-component o.b.v. de persoonlijke classificatie. 'ref' (referentiefase)
-// krijgt bewust factor 1.00 (neutraal, geen correctie) — nooit een absolute uitspraak
-// zonder eigen data, conform de fase1/2/3-personalisatie elders in de app.
-function hrvDagFactorPersonal(hdRows, refDate){
-  const c=hrvStPersonal(hdRows, refDate);
-  const factor={g:1.05, o:0.93, r:0.85, ref:1.00}[c.st];
-  return {factor, st:c.st, baseline:c.baseline, recent:c.recent, drop:c.drop};
-}
-
-// ══════════════════════════════════════════════════════════
-// DAGFACTOR-MOTOR (v300, HRV-component vernieuwd in Sprint 5.7.1)
-// Correctie op basis van HRV, slaap en (bij vrouwen) cyclusfase.
-// Puur informatief — past nergens automatisch een ingevuld gewicht aan.
-// Clip-principe zelfde als rekenmotor.py (MMP): dempt extreme uitschieters
-// als de drie factoren met elkaar vermenigvuldigd worden.
-// ══════════════════════════════════════════════════════════
-function slaapDagFactor(uren){ return CalcCore.slaapDagFactor(uren); } /* F1.5C: canonical shared core (dayfactor.v1) */
-function cyclusDagFactor(fase){ return CalcCore.cyclusDagFactor(fase); } /* F1.5C: canonical shared core (dayfactor.v1) */
-// hrvComponent = output van hrvDagFactorPersonal(hdRows, refDate) — vervangt de oude
-// losse hrv-ms-waarde als eerste argument (Sprint 5.7.1, breaking change binnen dit
-// bestand; alle aanroepen in dezelfde sprint bijgewerkt).
-function dagfactor(hrvComponent,slaapUren,cyclusFase){
-  const hc = hrvComponent || {factor:1.00, st:'ref', baseline:null};
-  const hrvFactor=hc.factor;
-  const slaapFactor=slaapDagFactor(slaapUren);
-  const cyclusFactor=cyclusDagFactor(cyclusFase);
-  /* F1.5C: product/clamp/round -> CalcCore.calculateDayFactor (dayfactor.v1) */
-  const factor=CalcCore.calculateDayFactor({hrvFactor,sleepHours:slaapUren,cyclePhase:cyclusFase});
-  return {factor,hrvFactor,slaapFactor,cyclusFactor,hrvSt:hc.st,hrvBaseline:hc.baseline};
-}
-// P1 — ÉÉN zichtbare Recovery Score 0-100 via de deterministische CalcCore (recovery_score.v1).
-// Voedt uitsluitend met BESCHIKBARE data: dagfactor (HRV·slaap·cyclus) + gemiddeld spierherstel
-// (+ optioneel RHR-delta / gevoel indien aanwezig). Geen fabricage; ontbrekende inputs → lagere confidence.
-function recoveryScoreFrom(dfInfo, recRows, extra){
-  const input={};
-  if(dfInfo && typeof dfInfo.factor==='number') input.dayFactor=dfInfo.factor;
-  if(Array.isArray(recRows) && recRows.length){
-    const pcts=recRows.map(r=>r&&r.pct).filter(v=>typeof v==='number');
-    if(pcts.length) input.muscleRecoveryPct=Math.round(pcts.reduce((a,b)=>a+b,0)/pcts.length);
-  }
-  if(extra && typeof extra.rhrDelta==='number') input.rhrDelta=extra.rhrDelta;
-  if(extra && extra.voelt) input.voelt=extra.voelt;
-  return CalcCore.recoveryScore(input);
-}
-// P1 — UNIVERSELE recovery-aanpassing: bepaalt deterministisch de sets/RPE-delta voor vandaag uit de
-// BESTAANDE data (dagfactor + spierherstel) via DecisionCore.computeProgAdjustment. Hergebruikt exact
-// dezelfde regels als de programmaflow; geen check-in vereist (voelt/pijn = null indien afwezig). Geen AI.
-// Retourneert een neutrale (0,0)-aanpassing als er geen herstel-data is (geen fabricage).
-// RHR-delta t.o.v. eigen baseline (gemiddelde van eerdere metingen). +bpm = slechter herstel.
-// <2 metingen → null (geen fabricage). Deterministisch.
-function rhrBaselineDelta(hd){
-  try{
-    const rows=(hd||[]).map(r=>parseFloat(r&&r.rhr)).filter(v=>isFinite(v)&&v>0);
-    if(rows.length<2) return null;
-    const today=rows[0]; const base=rows.slice(1).reduce((s,v)=>s+v,0)/(rows.length-1);
-    return Math.round((today-base)*10)/10;
-  }catch(_){ return null; }
-}
