-async function exportCSV(table){
-  const data = await sbGet(table,'&order=date.asc&limit=5000');
-  if(!data.length){toast('Geen data om te exporteren');return;}
-  const headers = Object.keys(data[0]);
-  const escapeCSV = v => {
-    if(v===null||v===undefined) return '';
-    const s = String(v);
-    if(s.includes(',') || s.includes('"') || s.includes(String.fromCharCode(10))){
-      return '"' + s.replace(/"/g, '""') + '"';
-    }
-    return s;
-  };
-  const rows = data.map(r=>headers.map(h=>escapeCSV(r[h])).join(','));
-  const csv = [headers.join(',')].concat(rows).join(String.fromCharCode(10));
-  downloadFile(csv, table+'_export_'+td()+'.csv', 'text/csv');
-  toast(table+' geexporteerd');
-}
