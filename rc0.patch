-.gw-reps-l{font-size:12px;font-weight:700;color:var(--g4)}
-.gw-reps-l span{font-weight:600;opacity:.7}
-.gw-reps-in{width:120px;text-align:center;font-size:20px;font-weight:800;font-family:var(--f);color:var(--dark);background:var(--g1);border:1px solid var(--g1);border-radius:12px;padding:8px 10px}
-.tpv2-d-hero{width:100%;height:170px;border-radius:16px;background:var(--g1);object-fit:contain;display:flex;align-items:center;justify-content:center;color:var(--g3);font-size:46px;margin-bottom:12px}
