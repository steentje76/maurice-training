-async function refreshMuscleRecovery(){
-  const el = document.getElementById('stats-recovery-content');
-  if(!el) return;
-  const twoWeeksAgo = new Date();
-  twoWeeksAgo.setDate(twoWeeksAgo.getDate()-14);
-  const dateStr = twoWeeksAgo.toISOString().split('T')[0];
-  // Geen weight/sets/reps-filter meer: dat sloot alle cardio-sessies (tijd/afstand-based)
-  // structureel uit van spierherstel, ook als ze getagd zijn. Herstel kijkt naar tijd
-  // sinds laatste sessie + RPE, niet naar setvolume — dus alle sessietypen tellen mee.
-  const ss = await sbGet('sessions','&date=gte.'+dateStr+'&order=date.desc,created_at.desc');
-  const lastHit = {};
-  ss.forEach(s=>{
-    const muscles = getExerciseMuscles(s.exercise_id);
-    muscles.forEach(m=>{
-      if(!lastHit[m]) lastHit[m] = {date:s.date, rpe:s.rpe};
-    });
-  });
-  const now = new Date();
-  const rows = Object.keys(MUSCLE_RECOVERY_HOURS).map(m=>{
-    const hit = lastHit[m];
-    if(!hit) return {muscle:m, pct:100, hours:null};
-    const hoursSince = (now - new Date(hit.date)) / 3600000;
-    const pct = computeMuscleRecoveryPct(hoursSince, MUSCLE_RECOVERY_HOURS[m], hit.rpe);
-    return {muscle:m, pct, hours:Math.round(hoursSince)};
-  }).sort((a,b)=>a.pct-b.pct);
-  const withData = rows.filter(r=>r.hours!==null);
-  const overall = withData.length ? Math.round(withData.reduce((a,r)=>a+r.pct,0)/withData.length) : 100;
-  const overallColor = overall>=85?'var(--green)':overall>=50?'var(--y)':'var(--red)';
-  let html = `<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
-    <div style="font-size:28px;font-weight:800;color:${overallColor}">${overall}%</div>
-    <div style="font-size:12px;color:var(--g4)">Gemiddeld herstel — spiergroepen met trainingsdata laatste 14 dagen</div>
-  </div>`;
